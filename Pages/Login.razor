@page "/login"
@using HealthApp.Client.Models
@using HealthApp.Client.Services
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Logga in</PageTitle>

<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-4">
        <div class="card shadow">
            <div class="card-body p-4">
                <h2 class="text-center mb-4">🔐 Logga in</h2>

                <div class="mb-3">
                    <label class="form-label">Användarnamn</label>
                    <input class="form-control" @bind="loginRequest.Username" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Lösenord</label>
                    <input class="form-control" type="password" @bind="loginRequest.Password" />
                </div>

                <button class="btn btn-primary w-100" @onclick="HandleLogin">Logga in</button>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger mt-3">@errorMessage</div>
                }

                <p class="mt-3 text-center">
                    Har du inget konto? <a href="/register">Registrera dig här</a>
                </p>
            </div>
        </div>
    </div>
</div>

@code {
    private LoginRequest loginRequest = new();
    private string errorMessage = string.Empty;

    private async Task HandleLogin()
    {
        var response = await AuthService.LoginAsync(loginRequest);
        if (response != null)
        {
            Navigation.NavigateTo("/", forceLoad: true);
        }
        else
        {
            errorMessage = "Fel användarnamn eller lösenord.";
        }
    }
}