@page "/login"
@using HealthApp.Client.Layout
@using HealthApp.Client.Models
@using HealthApp.Client.Services
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Logga in</PageTitle>

<AuthFormCard Icon="@Icons.Material.Filled.Login"
              Title="Logga in"
              SubmitLabel="Logga in"
              ErrorMessage="@errorMessage"
              IsSubmitting="isSubmitting"
              OnSubmit="HandleLogin"
              AlternativeText="Har du inget konto?"
              AlternativeHref="/register"
              AlternativeLinkLabel="Registrera dig här">
    <MudTextField @bind-Value="loginRequest.Username"
                  Label="Användarnamn"
                  Variant="Variant.Outlined"
                  Class="mb-3"
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Person" />
    <MudTextField @bind-Value="loginRequest.Password"
                  Label="Lösenord"
                  Variant="Variant.Outlined"
                  InputType="InputType.Password"
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Lock" />
</AuthFormCard>

@code {
    private LoginRequest loginRequest = new();
    private string errorMessage = string.Empty;
    private bool isSubmitting;

    private async Task HandleLogin()
    {
        errorMessage = string.Empty;
        isSubmitting = true;

        var response = await AuthService.LoginAsync(loginRequest);
        if (response != null)
        {
            Navigation.NavigateTo("/", forceLoad: true);
        }
        else
        {
            errorMessage = "Fel användarnamn eller lösenord.";
        }

        isSubmitting = false;
    }
}
