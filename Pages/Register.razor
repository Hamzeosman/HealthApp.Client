@page "/register"
@using HealthApp.Client.Layout
@using HealthApp.Client.Models
@using HealthApp.Client.Services
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Registrera</PageTitle>

<AuthFormCard Icon="@Icons.Material.Filled.PersonAdd"
              Title="Registrera dig"
              SubmitLabel="Registrera"
              ErrorMessage="@errorMessage"
              IsSubmitting="isSubmitting"
              OnSubmit="HandleRegister"
              AlternativeText="Har du redan ett konto?"
              AlternativeHref="/login"
              AlternativeLinkLabel="Logga in här">
    <MudTextField @bind-Value="registerRequest.Username"
                  Label="Användarnamn"
                  Variant="Variant.Outlined"
                  Class="mb-3"
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Person" />
    <MudTextField @bind-Value="registerRequest.Email"
                  Label="E-post"
                  Variant="Variant.Outlined"
                  InputType="InputType.Email"
                  Class="mb-3"
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Email" />
    <MudTextField @bind-Value="registerRequest.Password"
                  Label="Lösenord"
                  Variant="Variant.Outlined"
                  InputType="InputType.Password"
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Lock" />
</AuthFormCard>

@code {
    private RegisterRequest registerRequest = new();
    private string errorMessage = string.Empty;
    private bool isSubmitting;

    private async Task HandleRegister()
    {
        errorMessage = string.Empty;
        isSubmitting = true;

        var response = await AuthService.RegisterAsync(registerRequest);
        if (response != null)
        {
            Navigation.NavigateTo("/login");
        }
        else
        {
            errorMessage = "Något gick fel. Användarnamnet kan vara upptaget.";
        }

        isSubmitting = false;
    }
}
