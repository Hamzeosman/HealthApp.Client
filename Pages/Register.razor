@page "/register"
@using HealthApp.Client.Models
@using HealthApp.Client.Services
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Registrera</PageTitle>

<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-4">
        <div class="card shadow">
            <div class="card-body p-4">
                <h2 class="text-center mb-4">✨ Registrera dig</h2>

                <div class="mb-3">
                    <label class="form-label">Användarnamn</label>
                    <input class="form-control" @bind="registerRequest.Username" />
                </div>

                <div class="mb-3">
                    <label class="form-label">E-post</label>
                    <input class="form-control" type="email" @bind="registerRequest.Email" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Lösenord</label>
                    <input class="form-control" type="password" @bind="registerRequest.Password" />
                </div>

                <button class="btn btn-primary w-100" @onclick="HandleRegister">Registrera</button>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger mt-3">@errorMessage</div>
                }

                <p class="mt-3 text-center">
                    Har du redan ett konto? <a href="/login">Logga in här</a>
                </p>
            </div>
        </div>
    </div>
</div>

@code {
    private RegisterRequest registerRequest = new();
    private string errorMessage = string.Empty;

    private async Task HandleRegister()
    {
        var response = await AuthService.RegisterAsync(registerRequest);
        if (response != null)
        {
            Navigation.NavigateTo("/login");
        }
        else
        {
            errorMessage = "Något gick fel. Användarnamnet kan vara upptaget.";
        }
    }
}