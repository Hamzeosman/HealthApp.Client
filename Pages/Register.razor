@page "/register"
@using HealthApp.Client.Models
@using HealthApp.Client.Services
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Registrera</PageTitle>

<h1>Registrera dig</h1>

<div class="form-container">
    <div class="mb-3">
        <label class="form-label">Användarnamn</label>
        <input class="form-control" @bind="registerRequest.Username" />
    </div>

    <div class="mb-3">
        <label class="form-label">E-post</label>
        <input class="form-control" type="email" @bind="registerRequest.Email" />
    </div>

    <div class="mb-3">
        <label class="form-label">Lösenord</label>
        <input class="form-control" type="password" @bind="registerRequest.Password" />
    </div>

    <button class="btn btn-primary" @onclick="HandleRegister">Registrera</button>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger mt-3">@errorMessage</div>
    }

    <p class="mt-3">
        Har du redan ett konto? <a href="/login">Logga in här</a>
    </p>
</div>

@code {
    private RegisterRequest registerRequest = new();
    private string errorMessage = string.Empty;

    private async Task HandleRegister()
    {
        var response = await AuthService.RegisterAsync(registerRequest);
        if (response != null)
        {
            Navigation.NavigateTo("/login");
        }
        else
        {
            errorMessage = "Något gick fel. Användarnamnet kan vara upptaget.";
        }
    }
}