@page "/achievements"
@using System.Net.Http.Json
@inject HttpClient Http
@inject Mintakt.Client.Services.AuthService AuthService

<PageTitle>Prestationer</PageTitle>

<h1>🏆 Prestationer</h1>
<p class="text-muted">Dina träningsmilstolpar och framsteg</p>

@if (streak != null)
{
    <div class="card shadow mb-4" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); color: white;">
        <div class="card-body">
            <h3>🔥 Din streak</h3>
            <div class="row">
                <div class="col-md-4 text-center">
                    <h6>Nuvarande streak</h6>
                    <h2>@streak.CurrentStreak dagar</h2>
                </div>
                <div class="col-md-4 text-center">
                    <h6>Längsta streak</h6>
                    <h2>@streak.LongestStreak dagar</h2>
                </div>
                <div class="col-md-4 text-center">
                    <h6>Totalt antal pass</h6>
                    <h2>@streak.TotalWorkouts</h2>
                </div>
            </div>
        </div>
    </div>
}

@if (achievements == null)
{
    <p>Laddar...</p>
}
else if (!achievements.Any())
{
    <p>Inga prestationer hittades.</p>
}
else
{
    var unlockedCount = achievements.Count(a => a.IsUnlocked);
    var totalCount = achievements.Count;

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>🏅 Prestationer</h3>
        <span class="badge bg-success fs-6">@unlockedCount / @totalCount upplåsta</span>
    </div>

    <div class="row">
        @foreach (var achievement in achievements)
        {
            <div class="col-md-6 col-lg-4 mb-3">
                <div class="card h-100 shadow-sm @(achievement.IsUnlocked ? "border-success" : "")" style="@(achievement.IsUnlocked ? "" : "opacity: 0.75;")">
                    <div class="card-body text-center">
                        <div style="font-size: 3rem;">@GetIcon(achievement.Icon)</div>
                        <h5 class="card-title">
                            @achievement.Title
                            @if (achievement.IsUnlocked)
                            {
                                <span class="badge bg-success ms-2">✓</span>
                            }
                        </h5>
                        <p class="card-text">@achievement.Description</p>
                        
                        <div class="mt-3">
                            <div class="progress" style="height: 20px;">
                                <div class="progress-bar @(achievement.IsUnlocked ? "bg-success" : "bg-info")"
                                     role="progressbar"
                                     style="width: @(achievement.Progress)%;"
                                     aria-valuenow="@achievement.Progress"
                                     aria-valuemin="0"
                                     aria-valuemax="100">
                                    @achievement.Progress.ToString("0")%
                                </div>
                            </div>
                            <small class="text-muted mt-1 d-block">
                                @achievement.Current.ToString("0") / @achievement.Required.ToString("0") @GetRequirementLabel(achievement.RequirementType)
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<AchievementStatusDto>? achievements;
    private StreakDto? streak;

    protected override async Task OnInitializedAsync()
    {
        await AuthService.IsAuthenticatedAsync();
        try
        {
            achievements = await Http.GetFromJsonAsync<List<AchievementStatusDto>>("api/achievements/me");
        }
        catch
        {
            achievements = new List<AchievementStatusDto>();
        }

        try
        {
            streak = await Http.GetFromJsonAsync<StreakDto>("api/achievements/streak");
        }
        catch { }
    }

    private string GetIcon(string? icon) => icon switch
    {
        "trophy" => "🏆",
        "medal" => "🥇",
        "star" => "⭐",
        "fire" => "🔥",
        "lightning" => "⚡",
        "crown" => "👑",
        "shoe" => "👟",
        "chart" => "📈",
        _ => icon ?? "🎖️"
    };

    private string GetRequirementLabel(string? type) => type switch
    {
        "total_sessions" => "träningspass",
        "total_volume" => "kg lyfta",
        "streak_days" => "dagar i rad",
        "personal_record" => "personbästa",
        "total_distance" => "km",
        "weight_lost" => "kg viktnedgång",
        _ => ""
    };

    public class AchievementStatusDto
    {
        public string Code { get; set; } = "";
        public string Title { get; set; } = "";
        public string Description { get; set; } = "";
        public string Icon { get; set; } = "";
        public string RequirementType { get; set; } = "";
        public decimal Required { get; set; }
        public decimal Current { get; set; }
        public bool IsUnlocked { get; set; }
        public double Progress { get; set; }
    }

    public class StreakDto
    {
        public int CurrentStreak { get; set; }
        public int LongestStreak { get; set; }
        public int TotalWorkouts { get; set; }
    }
}