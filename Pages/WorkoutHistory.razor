@page "/workout-history"
@using System.Net.Http.Json
@using System.Globalization
@inject HttpClient Http
@inject Mintakt.Client.Services.AuthService AuthService
@inject IJSRuntime JS

<PageTitle>Träningshistorik</PageTitle>

<h1>📊 Träningshistorik</h1>
<p class="text-muted">Dina loggade träningspass över tid</p>

@if (sessions == null)
{
    <p>Laddar...</p>
}
else if (!sessions.Any())
{
    <p>Inga träningspass loggade ännu.</p>
}
else
{
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">Totalt antal pass</h6>
                    <h3>@sessions.Count</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">Total tid (min)</h6>
                    <h3>@sessions.Sum(s => s.DurationMinutes ?? 0)</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">Snittlängd (min)</h6>
                    <h3>@sessions.Average(s => s.DurationMinutes ?? 0).ToString("0")</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">Antal veckor</h6>
                    <h3>@sessions.Where(s => s.Date.HasValue).Select(s => GetWeek(s.Date!.Value)).Distinct().Count()</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow mb-4">
        <div class="card-body">
            <h4>📈 Pass per vecka</h4>
            <div style="height: 300px;">
                <canvas id="weeklyChart"></canvas>
            </div>
        </div>
    </div>

    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Datum</th>
                <th>Längd (min)</th>
                <th>Kalorier</th>
                <th>Känsla</th>
                <th>Anteckningar</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var session in sessions)
            {
                <tr>
                    <td>@session.Date?.ToString("yyyy-MM-dd")</td>
                    <td>@session.DurationMinutes</td>
                    <td>@session.TotalCalories</td>
                    <td>@GetMoodLabel(session.Mood)</td>
                    <td>@session.Notes</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<WorkoutSessionDto>? sessions;

    protected override async Task OnInitializedAsync()
    {
        await AuthService.IsAuthenticatedAsync();
        sessions = await Http.GetFromJsonAsync<List<WorkoutSessionDto>>("api/workouthistory");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (sessions != null && sessions.Any())
        {
            var grouped = sessions
                .Where(s => s.Date.HasValue)
                .GroupBy(s => GetWeek(s.Date!.Value))
                .OrderBy(g => g.Key)
                .ToList();

            var labels = grouped.Select(g => $"v{g.Key}").ToArray();
            var data = grouped.Select(g => (decimal)g.Count()).ToArray();
            await JS.InvokeVoidAsync("renderBarChart", "weeklyChart", labels, data, "Antal pass");
        }
    }

    private int GetWeek(DateTime date)
    {
        return CultureInfo.InvariantCulture.Calendar.GetWeekOfYear(date, CalendarWeekRule.FirstFourDayWeek, DayOfWeek.Monday);
    }

    private string GetMoodLabel(string? mood) => mood switch
    {
        "bra" => "😊 Bra",
        "okej" => "😐 Okej",
        "trött" => "😴 Trött",
        "stark" => "💪 Stark",
        _ => mood ?? ""
    };

    public class WorkoutSessionDto
    {
        public int Id { get; set; }
        public int? UserId { get; set; }
        public DateTime? Date { get; set; }
        public int? DurationMinutes { get; set; }
        public int? TotalCalories { get; set; }
        public string? Mood { get; set; }
        public string? Notes { get; set; }
    }
}