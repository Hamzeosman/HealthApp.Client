@page "/log-body-measurement"
@using System.Net.Http.Json
@using Mintakt.Client.Layout
@inject HttpClient Http
@inject Mintakt.Client.Services.AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Logga kroppsmått</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-6">
    <MudCard Elevation="0" Style="@($"border: {AppTokens.CardBorder};")">
        <MudCardContent Class="pa-6">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-6">
                <MudIcon Icon="@Icons.Material.Filled.Straighten" Color="Color.Primary" Size="Size.Large" />
                <MudText Typo="Typo.h4" Style="font-weight: 700;">Logga kroppsmått</MudText>
            </MudStack>

            <MudDatePicker Label="Datum"
                           @bind-Date="measurement.Date"
                           AdornmentIcon="@Icons.Material.Filled.CalendarToday"
                           Adornment="Adornment.Start"
                           Variant="Variant.Outlined"
                           Class="mb-4" />

            <MudNumericField T="decimal?"
                             Label="Vikt (kg)"
                             @bind-Value="measurement.WeightKg"
                             AdornmentIcon="@Icons.Material.Filled.MonitorWeight"
                             Adornment="Adornment.Start"
                             Variant="Variant.Outlined"
                             Step="0.1m"
                             Min="0"
                             Class="mb-4" />

            <MudNumericField T="decimal?"
                             Label="Kroppsfett (%)"
                             @bind-Value="measurement.BodyFatPercentage"
                             AdornmentIcon="@Icons.Material.Filled.Percent"
                             Adornment="Adornment.Start"
                             Variant="Variant.Outlined"
                             Step="0.1m"
                             Min="0"
                             Class="mb-4" />

            <MudNumericField T="decimal?"
                             Label="Bröst (cm)"
                             @bind-Value="measurement.ChestCm"
                             AdornmentIcon="@Icons.Material.Filled.Straighten"
                             Adornment="Adornment.Start"
                             Variant="Variant.Outlined"
                             Step="0.1m"
                             Min="0"
                             Class="mb-4" />

            <MudNumericField T="decimal?"
                             Label="Midja (cm)"
                             @bind-Value="measurement.WaistCm"
                             AdornmentIcon="@Icons.Material.Filled.Straighten"
                             Adornment="Adornment.Start"
                             Variant="Variant.Outlined"
                             Step="0.1m"
                             Min="0"
                             Class="mb-4" />

            <MudNumericField T="decimal?"
                             Label="Höft (cm)"
                             @bind-Value="measurement.HipsCm"
                             AdornmentIcon="@Icons.Material.Filled.Straighten"
                             Adornment="Adornment.Start"
                             Variant="Variant.Outlined"
                             Step="0.1m"
                             Min="0"
                             Class="mb-4" />

            <MudNumericField T="decimal?"
                             Label="Biceps (cm)"
                             @bind-Value="measurement.BicepCm"
                             AdornmentIcon="@Icons.Material.Filled.Straighten"
                             Adornment="Adornment.Start"
                             Variant="Variant.Outlined"
                             Step="0.1m"
                             Min="0"
                             Class="mb-4" />

            <MudNumericField T="decimal?"
                             Label="Lår (cm)"
                             @bind-Value="measurement.ThighCm"
                             AdornmentIcon="@Icons.Material.Filled.Straighten"
                             Adornment="Adornment.Start"
                             Variant="Variant.Outlined"
                             Step="0.1m"
                             Min="0"
                             Class="mb-4" />

            <MudButton OnClick="HandleSubmit"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       Size="Size.Large"
                       FullWidth="true">
                Spara mått
            </MudButton>

            @if (!string.IsNullOrEmpty(message))
            {
                <MudAlert Severity="@(isSuccess ? Severity.Success : Severity.Error)" Class="mt-4">
                    @message
                </MudAlert>
            }
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    private BodyMeasurementDto measurement = new() { Date = DateTime.Today };
    private string message = string.Empty;
    private bool isSuccess = false;

    protected override async Task OnInitializedAsync()
    {
        await AuthService.IsAuthenticatedAsync();
    }

    private async Task HandleSubmit()
    {
        var response = await Http.PostAsJsonAsync("api/bodymeasurements", measurement);
        if (response.IsSuccessStatusCode)
        {
            message = "Mått sparade!";
            isSuccess = true;
            measurement = new() { Date = DateTime.Today };
        }
        else
        {
            message = "Något gick fel, försök igen.";
            isSuccess = false;
        }
    }

    public class BodyMeasurementDto
    {
        public DateTime? Date { get; set; }
        public decimal? WeightKg { get; set; }
        public decimal? BodyFatPercentage { get; set; }
        public decimal? ChestCm { get; set; }
        public decimal? WaistCm { get; set; }
        public decimal? HipsCm { get; set; }
        public decimal? BicepCm { get; set; }
        public decimal? ThighCm { get; set; }
    }
}