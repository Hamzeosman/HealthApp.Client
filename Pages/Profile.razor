@page "/profile"
@using Mintakt.Client.Models
@using Mintakt.Client.Services
@using Mintakt.Client.Layout
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Min profil</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-6">
    <MudCard Elevation="0" Style="@($"border: {AppTokens.CardBorder};")">
        <MudCardContent Class="pa-6">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-6">
                <MudIcon Icon="@Icons.Material.Filled.Person" Color="Color.Primary" Size="Size.Large" />
                <MudText Typo="Typo.h4" Style="font-weight: 700;">Min profil</MudText>
            </MudStack>

            @if (isLoading)
            {
                <div class="d-flex justify-content-center py-4">
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                </div>
            }
            else if (profile == null)
            {
                <MudAlert Severity="Severity.Warning">
                    Kunde inte ladda profilen. Är du inloggad?
                </MudAlert>
            }
            else
            {
                <MudTextField T="string"
                              Label="Användarnamn"
                              Value="@profile.Name"
                              AdornmentIcon="@Icons.Material.Filled.Person"
                              Adornment="Adornment.Start"
                              Variant="Variant.Outlined"
                              ReadOnly="true"
                              Class="mb-4" />

                <MudTextField T="string"
                              Label="E-post"
                              Value="@profile.Email"
                              AdornmentIcon="@Icons.Material.Filled.Email"
                              Adornment="Adornment.Start"
                              Variant="Variant.Outlined"
                              ReadOnly="true"
                              Class="mb-4" />

                <MudDivider Class="my-4" />

                <MudGrid>
                    <MudItem xs="12" md="4">
                        <MudNumericField T="int?"
                                         Label="Ålder"
                                         @bind-Value="updateRequest.Age"
                                         AdornmentIcon="@Icons.Material.Filled.Cake"
                                         Adornment="Adornment.Start"
                                         Variant="Variant.Outlined"
                                         Min="0"
                                         Max="150"
                                         Class="mb-4" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudNumericField T="decimal?"
                                         Label="Vikt (kg)"
                                         @bind-Value="updateRequest.WeightKg"
                                         AdornmentIcon="@Icons.Material.Filled.MonitorWeight"
                                         Adornment="Adornment.Start"
                                         Variant="Variant.Outlined"
                                         Step="0.1m"
                                         Min="0"
                                         Class="mb-4" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudNumericField T="decimal?"
                                         Label="Längd (cm)"
                                         @bind-Value="updateRequest.HeightCm"
                                         AdornmentIcon="@Icons.Material.Filled.Height"
                                         Adornment="Adornment.Start"
                                         Variant="Variant.Outlined"
                                         Step="0.1m"
                                         Min="0"
                                         Class="mb-4" />
                    </MudItem>
                </MudGrid>

                <MudSelect T="string"
                           Label="Träningsnivå"
                           @bind-Value="updateRequest.FitnessLevel"
                           AdornmentIcon="@Icons.Material.Filled.FitnessCenter"
                           Adornment="Adornment.Start"
                           Variant="Variant.Outlined"
                           Class="mb-4">
                    <MudSelectItem Value="@("Beginner")">Nybörjare</MudSelectItem>
                    <MudSelectItem Value="@("Intermediate")">Medel</MudSelectItem>
                    <MudSelectItem Value="@("Advanced")">Avancerad</MudSelectItem>
                </MudSelect>

                <MudTextField T="string"
                              Label="Mål"
                              @bind-Value="updateRequest.Goal"
                              AdornmentIcon="@Icons.Material.Filled.EmojiEvents"
                              Adornment="Adornment.Start"
                              Variant="Variant.Outlined"
                              Lines="3"
                              Placeholder="T.ex. Bygga muskler, gå ner i vikt, springa ett maraton..."
                              Class="mb-4" />

                <MudButton OnClick="HandleSave"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Large"
                           Disabled="@isSaving"
                           StartIcon="@Icons.Material.Filled.Save"
                           FullWidth="true">
                    @(isSaving ? "Sparar..." : "Spara ändringar")
                </MudButton>

                @if (!string.IsNullOrEmpty(successMessage))
                {
                    <MudAlert Severity="Severity.Success" Class="mt-4">@successMessage</MudAlert>
                }
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <MudAlert Severity="Severity.Error" Class="mt-4">@errorMessage</MudAlert>
                }

                <MudText Typo="Typo.caption" Align="Align.Center" Class="mt-4 d-block" Style="@($"color: {AppTokens.TextSecondary};")">
                    Medlem sedan @profile.CreatedAt.ToString("yyyy-MM-dd")
                </MudText>
            }
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    private UserProfile? profile;
    private UpdateProfileRequest updateRequest = new();
    private bool isLoading = true;
    private bool isSaving = false;
    private string successMessage = string.Empty;
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var authed = await AuthService.IsAuthenticatedAsync();
        if (!authed)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        profile = await AuthService.GetProfileAsync();
        if (profile != null)
        {
            updateRequest = new UpdateProfileRequest
            {
                Age = profile.Age,
                WeightKg = profile.WeightKg,
                HeightCm = profile.HeightCm,
                FitnessLevel = profile.FitnessLevel,
                Goal = profile.Goal
            };
        }
        isLoading = false;
    }

    private async Task HandleSave()
    {
        successMessage = string.Empty;
        errorMessage = string.Empty;
        isSaving = true;

        var updated = await AuthService.UpdateProfileAsync(updateRequest);
        if (updated != null)
        {
            profile = updated;
            successMessage = "Profilen har sparats.";
        }
        else
        {
            errorMessage = "Kunde inte spara profilen. Försök igen.";
        }

        isSaving = false;
    }
}