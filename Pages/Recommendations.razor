@page "/recommendations"
@using System.Net.Http.Json
@inject HttpClient Http
@inject HealthApp.Client.Services.AuthService AuthService
@inject IJSRuntime JS

<PageTitle>Rekommendationer</PageTitle>

<h1>💡 AI-rekommendationer</h1>
<p class="text-muted">Personliga insikter baserade på din träningsdata</p>

@if (insights == null)
{
    <p>Laddar...</p>
}
else if (!insights.Any())
{
    <p>Inga rekommendationer hittades.</p>
}
else
{
    <div class="card shadow mb-4">
        <div class="card-body">
            <h4>📊 Fördelning per typ</h4>
            <div style="height: 300px;">
                <canvas id="typeChart"></canvas>
            </div>
        </div>
    </div>

    <h3>Alla insikter</h3>
    <div class="row">
        @foreach (var insight in insights)
        {
            <div class="col-md-6 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">@insight.Title</h5>
                        <p><span class="badge bg-info">@GetTypeLabel(insight.InsightType)</span></p>
                        <p class="card-text">@insight.Content</p>
                        <p><small class="text-muted">@insight.CreatedAt?.ToString("yyyy-MM-dd")</small></p>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<AiInsightDto>? insights;

    protected override async Task OnInitializedAsync()
    {
        await AuthService.IsAuthenticatedAsync();
        insights = await Http.GetFromJsonAsync<List<AiInsightDto>>("api/aiinsight");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (insights != null && insights.Any())
        {
            var grouped = insights
                .GroupBy(i => i.InsightType ?? "okänd")
                .ToList();

            var labels = grouped.Select(g => GetTypeLabel(g.Key)).ToArray();
            var data = grouped.Select(g => (decimal)g.Count()).ToArray();
            await JS.InvokeVoidAsync("renderPieChart", "typeChart", labels, data, "Insikter");
        }
    }

    private string GetTypeLabel(string? type) => type switch
    {
        "training_tip" => "Träningstips",
        "recovery_advice" => "Återhämtning",
        "nutrition_tip" => "Kosttips",
        "progress_summary" => "Framsteg",
        "weekly_analysis" => "Veckoanalys",
        _ => type ?? ""
    };

    public class AiInsightDto
    {
        public int Id { get; set; }
        public string? InsightType { get; set; }
        public string? Title { get; set; }
        public string? Content { get; set; }
        public bool IsRead { get; set; }
        public DateTime? CreatedAt { get; set; }
    }
}