@page "/log-workout"
@using System.Net.Http.Json
@using Mintakt.Client.Layout
@inject HttpClient Http
@inject Mintakt.Client.Services.AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Logga träningspass</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-6">
    <MudCard Elevation="0" Style="@($"border: {AppTokens.CardBorder};")">
        <MudCardContent Class="pa-6">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-6">
                <MudIcon Icon="@Icons.Material.Filled.AddCircle" Color="Color.Primary" Size="Size.Large" />
                <MudText Typo="Typo.h4" Style="font-weight: 700;">Logga träningspass</MudText>
            </MudStack>

            <MudDatePicker Label="Datum"
                           @bind-Date="dateValue"
                           AdornmentIcon="@Icons.Material.Filled.CalendarToday"
                           Adornment="Adornment.Start"
                           Variant="Variant.Outlined"
                           Class="mb-4" />

            <MudNumericField T="int?"
                             Label="Hur länge (minuter)"
                             @bind-Value="session.DurationMinutes"
                             AdornmentIcon="@Icons.Material.Filled.Timer"
                             Adornment="Adornment.Start"
                             Variant="Variant.Outlined"
                             Min="0"
                             Class="mb-4" />

            <MudSelect T="string"
                       Label="Hur kändes det?"
                       @bind-Value="session.Mood"
                       AdornmentIcon="@Icons.Material.Filled.Mood"
                       Adornment="Adornment.Start"
                       Variant="Variant.Outlined"
                       Class="mb-4">
                <MudSelectItem Value="@("bra")">Bra</MudSelectItem>
                <MudSelectItem Value="@("okej")">Okej</MudSelectItem>
                <MudSelectItem Value="@("trött")">Trött</MudSelectItem>
                <MudSelectItem Value="@("stark")">Stark</MudSelectItem>
            </MudSelect>

            <MudTextField T="string"
                          Label="Anteckningar"
                          @bind-Value="session.Notes"
                          AdornmentIcon="@Icons.Material.Filled.Notes"
                          Adornment="Adornment.Start"
                          Variant="Variant.Outlined"
                          Lines="3"
                          Placeholder="Hur gick passet? Övningar, vikter, känslor..."
                          Class="mb-4" />

            <MudButton OnClick="HandleSubmit"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       Size="Size.Large"
                       FullWidth="true">
                Spara träningspass
            </MudButton>

            @if (!string.IsNullOrEmpty(message))
            {
                <MudAlert Severity="@(isSuccess ? Severity.Success : Severity.Error)" Class="mt-4">
                    @message
                </MudAlert>
            }
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    private CreateWorkoutSessionDto session = new() { Date = DateTime.Today };
    private DateTime? dateValue = DateTime.Today;
    private string message = string.Empty;
    private bool isSuccess = false;

    protected override async Task OnInitializedAsync()
    {
        await AuthService.IsAuthenticatedAsync();
    }

    private async Task HandleSubmit()
    {
        // Backend läser user-id från JWT-claims via UserHelper (PR A1 #58).
        // Vi skickar därför inte UserId i DTO — om fältet finns i body skrivs det över på backend-sidan.
        session.Date = dateValue ?? DateTime.Today;

        var response = await Http.PostAsJsonAsync("api/workoutsession", session);
        if (response.IsSuccessStatusCode)
        {
            message = "Träningspass sparat!";
            isSuccess = true;
            session = new() { Date = DateTime.Today };
            dateValue = DateTime.Today;
        }
        else
        {
            message = "Något gick fel, försök igen.";
            isSuccess = false;
        }
    }

    public class CreateWorkoutSessionDto
    {
        public DateTime Date { get; set; }
        public int? DurationMinutes { get; set; }
        public string Mood { get; set; } = string.Empty;
        public string Notes { get; set; } = string.Empty;
    }
}