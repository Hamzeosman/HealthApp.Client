@page "/"
@using System.Net.Http.Json
@using HealthApp.Client.Layout
@inherits AuthAwareComponentBase
@inject HttpClient Http

<PageTitle>HealthApp</PageTitle>

<MudPaper Elevation="0" Class="pa-8 mb-6"
          Style="@($"background: {AppTokens.HeroGradient}; border: {AppTokens.CardBorder}; border-radius: 12px;")">
    <MudText Typo="Typo.h3" Style="font-weight: 800;">Välkommen tillbaka 💪</MudText>
    <MudText Typo="Typo.subtitle1" Color="Color.Secondary" Class="mt-2">Din personliga träningskompis</MudText>
</MudPaper>

@if (stats != null)
{
    <MudText Typo="Typo.h5" Class="mb-4" Style="font-weight: 700;">Översikt</MudText>
    <MudGrid Class="mb-8">
        @foreach (var s in StatCards)
        {
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="0" Class="pa-4" Style="@($"height: 100%; border: {AppTokens.CardBorder};")">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="4">
                        <MudIcon Icon="@s.Icon" Color="Color.Primary" Size="Size.Large" />
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.overline" Style="@($"color: {AppTokens.TextSecondary}; letter-spacing: 1px; font-weight: 600;")">@s.Label</MudText>
                            <MudText Typo="Typo.h3" Style="font-weight: 800; line-height: 1.1;">@s.Value</MudText>
                        </MudStack>
                    </MudStack>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
}

<MudText Typo="Typo.h5" Class="mb-4" Style="font-weight: 700;">Kom igång</MudText>
<MudGrid>
    @foreach (var card in ActionCards)
    {
        <MudItem xs="12" sm="6" md="4">
            <MudCard Elevation="0" Class="pa-4 d-flex flex-column"
                     Style="@($"height: 100%; border: {AppTokens.CardBorder};")">
                <MudCardContent Class="flex-grow-1 d-flex flex-column">
                    <MudIcon Icon="@card.Icon" Color="@(card.IsPrimary ? Color.Primary : Color.Default)" Size="Size.Large" Class="mb-3" />
                    <MudText Typo="Typo.h6" Style="font-weight: 700;">@card.Title</MudText>
                    <MudText Typo="Typo.body2" Style="@($"color: {AppTokens.TextSecondary};")" Class="mt-1 mb-4">@card.Description</MudText>
                    <MudSpacer />
                    <MudButton Href="@card.Href"
                               Variant="@(card.IsPrimary ? Variant.Filled : Variant.Outlined)"
                               Color="@(card.IsPrimary ? Color.Primary : Color.Default)"
                               EndIcon="@Icons.Material.Filled.ArrowForward"
                               FullWidth="true">@card.ButtonLabel</MudButton>
                </MudCardContent>
            </MudCard>
        </MudItem>
    }
</MudGrid>

@code {
    private record StatCard(string Icon, string Label, string Value);
    private record ActionCard(string Href, string Icon, string Title, string Description, string ButtonLabel, bool IsPrimary = false);

    private DashboardStats? stats;

    private StatCard[] StatCards => stats is null ? Array.Empty<StatCard>() : new[]
    {
        new StatCard(Icons.Material.Filled.FitnessCenter, "Träningspass",    stats.TotalWorkouts.ToString()),
        new StatCard(Icons.Material.Filled.DirectionsRun, "Löppass",         stats.TotalRunning.ToString()),
        new StatCard(Icons.Material.Filled.Route,         "Distans (km)",    stats.TotalDistance.ToString("0.0")),
        new StatCard(Icons.Material.Filled.Timer,         "Total tid (min)", stats.TotalDuration.ToString()),
    };

    private ActionCard[] ActionCards => new[]
    {
        new ActionCard("log-workout",     Icons.Material.Filled.AddCircle,     "Logga pass",         "Registrera dagens träningspass",            "Logga nu",       IsPrimary: true),
        new ActionCard("exercises",       Icons.Material.Filled.FitnessCenter, "Övningar",           $"Utforska {stats?.TotalExercises ?? 100}+ övningar",  "Visa övningar"),
        new ActionCard("training-plans",  Icons.Material.Filled.ListAlt,       "Träningsprogram",    $"{stats?.TotalPrograms ?? 21} färdiga program",       "Visa program"),
        new ActionCard("recommendations", Icons.Material.Filled.Lightbulb,     "AI-rekommendationer", $"{stats?.TotalInsights ?? 0} personliga insikter",   "Visa insikter"),
        new ActionCard("workout-history", Icons.Material.Filled.History,       "Historik",           "Se alla dina loggade träningspass",         "Visa historik"),
        new ActionCard("running",         Icons.Material.Filled.DirectionsRun, "Löpning",            "Spåra dina löppass och framsteg",           "Visa löpning"),
    };

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        if (IsAuthenticated)
        {
            try
            {
                stats = await Http.GetFromJsonAsync<DashboardStats>("api/dashboard");
            }
            catch { }
        }
    }

    public class DashboardStats
    {
        public int TotalWorkouts { get; set; }
        public int TotalRunning { get; set; }
        public decimal TotalDistance { get; set; }
        public int TotalDuration { get; set; }
        public int TotalExercises { get; set; }
        public int TotalPrograms { get; set; }
        public int TotalInsights { get; set; }
    }
}
