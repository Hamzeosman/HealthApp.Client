@page "/"
@using System.Net.Http.Json
@inject HttpClient Http
@inject HealthApp.Client.Services.AuthService AuthService

<PageTitle>HealthApp</PageTitle>

<div class="hero-section text-center py-5 mb-4" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; border-radius: 10px;">
    <h1 class="display-4 fw-bold">Välkommen till HealthApp! 💪</h1>
    <p class="lead">Din personliga träningskompis</p>
</div>

@if (stats != null)
{
    <h3 class="mb-3">📊 Översikt</h3>
    <div class="row mb-4">
        <div class="col-md-3 mb-3">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <div style="font-size: 2rem;">🏋️</div>
                    <h6 class="text-muted">Träningspass</h6>
                    <h3>@stats.TotalWorkouts</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <div style="font-size: 2rem;">🏃</div>
                    <h6 class="text-muted">Löppass</h6>
                    <h3>@stats.TotalRunning</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <div style="font-size: 2rem;">🛣️</div>
                    <h6 class="text-muted">Distans (km)</h6>
                    <h3>@stats.TotalDistance.ToString("0.0")</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <div style="font-size: 2rem;">⏱️</div>
                    <h6 class="text-muted">Total tid (min)</h6>
                    <h3>@stats.TotalDuration</h3>
                </div>
            </div>
        </div>
    </div>
}

<h3 class="mb-3">🚀 Kom igång</h3>
<div class="row">
    <div class="col-md-6 col-lg-4 mb-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body text-center">
                <div style="font-size: 3rem;">🏋️</div>
                <h5 class="card-title">Övningar</h5>
                <p class="card-text">Utforska @(stats?.TotalExercises ?? 100)+ övningar</p>
                <a href="exercises" class="btn btn-primary">Visa övningar</a>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-4 mb-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body text-center">
                <div style="font-size: 3rem;">📋</div>
                <h5 class="card-title">Träningsprogram</h5>
                <p class="card-text">@(stats?.TotalPrograms ?? 21) färdiga program</p>
                <a href="training-plans" class="btn btn-primary">Visa program</a>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-4 mb-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body text-center">
                <div style="font-size: 3rem;">💡</div>
                <h5 class="card-title">AI-rekommendationer</h5>
                <p class="card-text">@(stats?.TotalInsights ?? 0) personliga insikter</p>
                <a href="recommendations" class="btn btn-primary">Visa insikter</a>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-4 mb-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body text-center">
                <div style="font-size: 3rem;">📊</div>
                <h5 class="card-title">Historik</h5>
                <p class="card-text">Se alla dina loggade träningspass</p>
                <a href="workout-history" class="btn btn-primary">Visa historik</a>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-4 mb-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body text-center">
                <div style="font-size: 3rem;">🏃</div>
                <h5 class="card-title">Löpning</h5>
                <p class="card-text">Spåra dina löppass och framsteg</p>
                <a href="running" class="btn btn-primary">Visa löpning</a>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-4 mb-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body text-center">
                <div style="font-size: 3rem;">➕</div>
                <h5 class="card-title">Logga pass</h5>
                <p class="card-text">Registrera dagens träningspass</p>
                <a href="log-workout" class="btn btn-primary">Logga nu</a>
            </div>
        </div>
    </div>
</div>

@code {
    private DashboardStats? stats;

    protected override async Task OnInitializedAsync()
    {
        if (await AuthService.IsAuthenticatedAsync())
        {
            try
            {
                stats = await Http.GetFromJsonAsync<DashboardStats>("api/dashboard");
            }
            catch { }
        }
    }

    public class DashboardStats
    {
        public int TotalWorkouts { get; set; }
        public int TotalRunning { get; set; }
        public decimal TotalDistance { get; set; }
        public int TotalDuration { get; set; }
        public int TotalExercises { get; set; }
        public int TotalPrograms { get; set; }
        public int TotalInsights { get; set; }
    }
}