@page "/exercises"
@using System.Net.Http.Json
@inject HttpClient Http
@inject Mintakt.Client.Services.AuthService AuthService

<PageTitle>Övningar</PageTitle>

<h1>🏋️ Övningar</h1>
<p class="text-muted">Bläddra, sök och filtrera bland alla övningar</p>

<div class="row mb-4">
    <div class="col-md-6 mb-2">
        <input class="form-control" type="text" placeholder="🔍 Sök övning..." @bind="searchTerm" @bind:event="oninput" />
    </div>
    <div class="col-md-3 mb-2">
        <select class="form-control" @bind="selectedDifficulty">
            <option value="">Alla svårighetsgrader</option>
            <option value="nybörjare">Nybörjare</option>
            <option value="medel">Medel</option>
            <option value="avancerad">Avancerad</option>
        </select>
    </div>
    <div class="col-md-3 mb-2">
        <select class="form-control" @bind="selectedType">
            <option value="">Alla typer</option>
            <option value="styrka">Styrka</option>
            <option value="kondition">Kondition</option>
            <option value="stretching">Stretching</option>
            <option value="balans">Balans</option>
        </select>
    </div>
</div>

@if (exercises == null)
{
    <p>Laddar...</p>
}
else if (!FilteredExercises.Any())
{
    <p>Inga övningar matchade dina filter.</p>
}
else
{
    <p class="text-muted">Visar @FilteredExercises.Count() övningar</p>
    <div class="row">
        @foreach (var exercise in FilteredExercises)
        {
            <div class="col-md-6 col-lg-4 mb-3">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">@exercise.Name</h5>
                        <p>
                            <span class="badge bg-primary">@exercise.Difficulty</span>
                            @if (!string.IsNullOrEmpty(exercise.ExerciseType))
                            {
                                <span class="badge bg-secondary">@exercise.ExerciseType</span>
                            }
                        </p>
                        <p class="card-text">@exercise.Description</p>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<ExerciseDto>? exercises;
    private string searchTerm = string.Empty;
    private string selectedDifficulty = string.Empty;
    private string selectedType = string.Empty;

    private IEnumerable<ExerciseDto> FilteredExercises =>
        exercises?.Where(e =>
            (string.IsNullOrEmpty(searchTerm) || (e.Name?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false)) &&
            (string.IsNullOrEmpty(selectedDifficulty) || e.Difficulty == selectedDifficulty) &&
            (string.IsNullOrEmpty(selectedType) || e.ExerciseType == selectedType))
        ?? Enumerable.Empty<ExerciseDto>();

    protected override async Task OnInitializedAsync()
    {
        await AuthService.IsAuthenticatedAsync();
        exercises = await Http.GetFromJsonAsync<List<ExerciseDto>>("api/exerciselibrary");
    }

    public class ExerciseDto
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public string Difficulty { get; set; } = string.Empty;
        public string? ExerciseType { get; set; }
    }
}