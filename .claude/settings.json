{
  "permissions": {
    "deny": [
      "Read(./.worktree/env.json)",
      "Read(**/UserSecrets/**)",
      "Read(~/.ssh/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-dangerous.mjs\""
          }
        ]
      }
    ]
  }
}
