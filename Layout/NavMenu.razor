@inherits AuthAwareComponentBase

<MudNavMenu Class="pt-4">
    <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Hem</MudNavLink>

    @if (IsAuthenticated)
    {
        @foreach (var group in NavItems.Authenticated)
        {
            <MudDivider Class="my-2" />
            <MudText Typo="Typo.caption" Class="px-4 py-1" Color="Color.Tertiary">@group.Title</MudText>
            @foreach (var item in group.Items)
            {
                <MudNavLink Href="@item.Href" Icon="@item.Icon">@item.Label</MudNavLink>
            }
        }
    }
    else
    {
        <MudDivider Class="my-2" />
        @foreach (var item in NavItems.Guest)
        {
            <MudNavLink Href="@item.Href" Icon="@item.Icon">@item.Label</MudNavLink>
        }
    }
</MudNavMenu>
